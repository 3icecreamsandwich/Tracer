{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracer-ai-test",
  "account_id": "ebb46f6b87971427afbdb712784fcdd7",
  "main": ".wrangler/ai-staging-entry.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {"directory": ".output-ai-staging-cloudflare/public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "observability": {"enabled": true, "logs": {"enabled": true, "invocation_logs": false}},
  "vars": {
    "TRACER_MAINTENANCE": "0", "TRACER_BUILD_SHA": "ai-staging", "NUXT_APP_BASE_URL": "/",
    "NUXT_SUPABASE_URL": "https://incejztkdiregaaxltiv.supabase.co",
    "NUXT_SUPABASE_PUBLISHABLE_KEY": "", "NUXT_GITHUB_OAUTH_CLIENT_ID": "",
    "NUXT_WEB_AI_COMPATIBLE_ORIGIN": "", "BUILTIN_AI_ENABLED": "0"
  },
  "ratelimits": [
    {"name":"WEB_RATE_LIMITER","namespace_id":"1007","simple":{"limit":120,"period":60}},
    {"name":"WEB_AI_RATE_LIMITER","namespace_id":"1008","simple":{"limit":30,"period":60}},
    {"name":"WEB_AUTH_RATE_LIMITER","namespace_id":"1009","simple":{"limit":20,"period":60}}
  ],
  "triggers": {"crons":["* * * * *"]}
}
