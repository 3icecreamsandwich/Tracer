{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracer-app-preview",
  "account_id": "ebb46f6b87971427afbdb712784fcdd7",
  "main": "cloudflare/entry.ts",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": ".output-cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "vars": {
    "TRACER_MAINTENANCE": "0",
    "TRACER_BUILD_SHA": "local",
    "NUXT_APP_BASE_URL": "/",
    "NUXT_GITHUB_OAUTH_CLIENT_ID": "",
    "NUXT_WEB_AI_COMPATIBLE_ORIGIN": "",
    "NUXT_SUPABASE_URL": "",
    "NUXT_SUPABASE_PUBLISHABLE_KEY": ""
  },
  "ratelimits": [
    {
      "name": "WEB_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "env": {
    "production": {
      "name": "tracer-app",
      "workers_dev": false,
      "vars": {
        "TRACER_MAINTENANCE": "0",
        "TRACER_BUILD_SHA": "local",
        "NUXT_APP_BASE_URL": "/",
        "NUXT_GITHUB_OAUTH_CLIENT_ID": "",
        "NUXT_WEB_AI_COMPATIBLE_ORIGIN": "",
        "NUXT_SUPABASE_URL": "",
        "NUXT_SUPABASE_PUBLISHABLE_KEY": ""
      },
      "ratelimits": [
        {
          "name": "WEB_RATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 120,
            "period": 60
          }
        }
      ]
    }
  }
}
