{
  "name": "tracer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 3000",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "tauri:dev": "bun run tauri dev",
    "tauri:build": "bun run tauri build",
    "test:unit": "vitest run && cd src-tauri && cargo test",
    "test:e2e:desktop": "node ./tests/e2e/desktop/run.mjs",
    "test:e2e:web": "node ./tests/e2e/web/run.mjs",
    "test": "node ./tests/run.mjs",
    "dev:web": "nuxt dev --host 127.0.0.1 --port 3001",
    "build:web": "nuxt build",
    "start:web": "node .output/server/index.mjs",
    "test:e2e:web-app": "playwright test --config playwright.web-app.config.ts",
    "preview:cloudflare": "wrangler dev --config .wrangler/tracer.json --port 3101",
    "deploy:cloudflare:preview": "wrangler deploy --config .wrangler/tracer.json",
    "deploy:cloudflare:production": "wrangler deploy --config .wrangler/tracer.json --env production",
    "build:cloudflare": "node scripts/cloudflare/build.mjs",
    "test:e2e:cloudflare": "TRACER_TEST_CLOUDFLARE=1 playwright test --config playwright.web-app.config.ts",
    "types:cloudflare": "node scripts/cloudflare/types.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.116",
    "@ai-sdk/google": "^3.0.121",
    "@ai-sdk/openai": "^3.0.109",
    "@ai-sdk/openai-compatible": "^2.0.74",
    "@lucide/vue": "1.36.0",
    "@supabase/supabase-js": "2.112.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "^2.6.0",
    "ai": "^7.0.99",
    "katex": "^0.17.0",
    "markdown-it": "^14.3.1",
    "nuxt": "^4.5.2",
    "ollama-ai-provider-v2": "^3.6.0",
    "pdfjs-dist": "^6.3.289",
    "sql.js": "1.14.2",
    "tesseract.js": "^7.0.0",
    "vue": "3.5.42"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.63.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "@tauri-apps/plugin-stronghold": "^2.3.2",
    "@types/markdown-it": "^14.2.0",
    "@types/sql.js": "1.4.11",
    "@wdio/cli": "^9.31.6",
    "@wdio/local-runner": "^9.31.6",
    "@wdio/mocha-framework": "^9.31.6",
    "@wdio/spec-reporter": "^9.31.2",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vitest": "^3.2.7",
    "webdriverio": "^9.31.6",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
